   OnFrobInvEnd()
   {
      linkset invent=Link.GetAll("Contains",message.Frobber);
      boolean haswater=FALSE;

      while(!haswater && invent.AnyLinksLeft())
      {
         if(Object.InheritsFrom(invent.Link().To(),Object.Named("water")))
            haswater=TRUE;
         invent.NextLink();
